# ──────────────────────────────────────────────────────────────────────
# Environment files (API keys, secrets)
# ──────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.envrc

# ──────────────────────────────────────────────────────────────────────
# Credentials & secrets — never commit these
# ──────────────────────────────────────────────────────────────────────
# OAuth / API tokens
refresh-token.json
oauth-token.json
tokens.json

# Google service account JSON (matches any depth — root, pipeline/, etc.)
google-service-account.json
service-account*.json
*service-account*.json
*-credentials.json
*-secret.json
firebase-adminsdk-*.json

# Keys & certificates
*.pem
*.key
*.p12
*.p8
*.pfx
*.jks
*.keystore

# SSH / GPG
id_rsa
id_ed25519
*.gpg
*.asc

# ──────────────────────────────────────────────────────────────────────
# Generated artifacts (resumes, PDFs, user uploads)
# ──────────────────────────────────────────────────────────────────────
server/resumes/
server/data/
server/uploads/
resumes/
uploads/

# Quick tests / ad-hoc artifacts that accumulate at repo root
test-resume-output.pdf
test-resume.json
test-*.pdf
test-*.json
scratch-*.pdf
scratch-*.json

# ──────────────────────────────────────────────────────────────────────
# Databases (legacy SQLite + any dropped-in DB files)
