# ==========================================================================
# GoCandid8 — Server environment
# ==========================================================================
# Copy this file to `server/.env` (gitignored) and fill in real values.
# Never commit the real .env — secrets leak through git history forever.

# ─── Port & CORS ──────────────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173

# ─── Supabase Auth ────────────────────────────────────────────────────────
# The server needs the project URL + anon key for JWT verification via
# middleware/auth.ts (supabase.auth.getUser(token)). Do NOT put the service
# role key here unless you explicitly need admin operations.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Supabase Postgres (direct connection for app data) ──────────────────
# Copy this from Supabase dashboard → Project Settings → Database →
# Connection string → "URI" (the one labeled `postgresql://postgres:...`).
# Use the "Session mode" connection (port 5432) for the Express server, not
# the pooler, because postgres.js handles its own connection pooling.
#
# The server uses this URL with postgres.js to read + write every app table
# (jobs, profiles, user_settings, skill_snapshots, etc.). RLS is bypassed
# at this connection level because the server acts as a trusted middleman
# that already enforces tenant scoping via req.user.id in WHERE clauses.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── Supabase Storage (service role, required for file uploads) ──────────
# The service role key bypasses RLS, which is what we want for server-side
# storage operations: the server knows whose files to write (via req.user.id)
# and scopes all paths with `{userId}/...`. Storage RLS still enforces that
# any direct browser uploads go into the caller's own folder.
#
# Get this from Supabase dashboard → Project Settings → API → "service_role"
# secret key. DO NOT ship this to the browser — it must live only on the
# server. If it leaks, anyone with it can read/write every user's files.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Server-internal pipeline auth ────────────────────────────────────────
# The server spawns the pipeline subprocess and injects this token +
# PIPELINE_USER_ID into its environment. The pipeline uses those to
# hit the server's own API via `Authorization: Internal <token>:<userId>`.
#
# You normally do NOT need to set this — server/src/index.ts generates
# a fresh random token at boot if it's unset. Only set it explicitly
# when running multiple server replicas that need to agree on the token.
# PIPELINE_INTERNAL_TOKEN=<long random string, 64+ hex chars>

# ─── OpenAI (used by on-demand interview prep + cover letter regen) ───────
OPENAI_API_KEY=sk-...

# ─── Gmail OAuth (outreach email feature) ─────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# The redirect URI must match your server's callback route exactly.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=https://YOUR_RAILWAY_URL.up.railway.app/api/gmail/callback

# ─── Railway / Production deployment ─────────────────────────────────────
# Set these on Railway (not here) to use system Chromium instead of
# Puppeteer's 200MB bundled download:
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ─── Legacy / optional ────────────────────────────────────────────────────
# JWT_SECRET is no longer used — auth lives in Supabase now. Safe to delete.
# JWT_SECRET=
