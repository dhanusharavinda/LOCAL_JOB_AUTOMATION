{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://localjobautomation-production.up.railway.app/api/:path*"
    },
    {
      "source": "/keep-alive",
      "destination": "https://localjobautomation-production.up.railway.app/keep-alive"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
