# ==========================================================================
# GO CANDID8 - Client environment (Vite)
# ==========================================================================
# Copy this file to `client/.env` and fill in YOUR OWN values.
#
# IMPORTANT: every variable prefixed with VITE_ is compiled into the
# JavaScript bundle that ships to the browser. Treat all of them as public.
# Never put the Supabase service-role key, a database URL, or any API
# secret in this file - those belong in `server/.env`, which never leaves
# the server.

# --- Supabase (required) --------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
# The anon key is public by design: it is a JWT whose only power is what
# your Row Level Security policies allow.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Support inbox (optional) ---------------------------------------------
# Shown in the floating "Contact" dialog as a mailto: fallback, and this
# is the address users are told their feedback goes to. Set it to your own
# inbox. If you leave it blank the email row and the "Email instead" link
# are hidden, and feedback is captured server-side only (POST /api/feedback,
# readable in the `feedback` table).
VITE_SUPPORT_EMAIL=
