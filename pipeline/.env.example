# ===========================================
# Job Automation Pipeline - Environment Config
# ===========================================
# Copy this file to .env and fill in your API keys

# Apify (LinkedIn scraping)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=your_apify_actor_id_here

# OpenAI (job relevance check + resume customization)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (outreach email generation)
GEMINI_API_KEY=your_gemini_key_here

# Gmail OAuth (per-user, optional)
# Gmail sync is an opt-in feature users connect from their Settings modal.
# These credentials come from a Google Cloud project you control; each
# authenticated user goes through the OAuth flow individually and their
# access + refresh tokens are stored per-user in Supabase. The server
# never stores a shared gmail-token.json anymore.
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Job Tracker API
JOB_TRACKER_URL=http://localhost:3001

# Client URL (for OAuth redirects)
CLIENT_URL=http://localhost:5173

# PDF Generation Backend
PDF_BACKEND_URL=https://rewrite-backend-b5wj.onrender.com/v1/get-resume

# ── LinkedIn Search (dynamic URL builder) ──
# Keywords: comma-separated job titles (joined with OR automatically)
LINKEDIN_KEYWORDS=data engineer,ai engineer,cloud engineer,data analyst,software engineer
# Skills: comma-separated skills appended as "skill developer" terms (optional, boosts relevance)
LINKEDIN_SKILLS=python,sql,aws,azure,spark,terraform
# Location geoId: 104738515=Ireland, 104347372=Dublin, 101165590=UK, 92000000=Worldwide
LINKEDIN_GEO_ID=104738515
# Time filter: r86400=24h, r604800=1week, r2592000=1month
LINKEDIN_TIME_FILTER=r86400
# Experience levels: 1=intern,2=entry,3=associate,4=mid-senior,5=director,6=executive
LINKEDIN_EXPERIENCE=1,2,3
# Work type (optional): 1=on-site,2=remote,3=hybrid
# LINKEDIN_WORK_TYPE=2,3
# Job type (optional): F=full-time,P=part-time,I=internship,C=contract
# LINKEDIN_JOB_TYPE=F
# Sort: DD=most recent, R=most relevant
LINKEDIN_SORT=DD
# Manual override: set this to skip the builder and use a raw URL instead
# LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs/search/?keywords=...

# Pipeline Settings
BATCH_DELAY_MS=2000
APIFY_JOB_COUNT=20
RELEVANCE_SCORE_THRESHOLD=7
# Resume tailoring intensity (1-10): 1=light touch, 5=balanced, 10=aggressive JD match
# Low (1-3): keeps original bullets mostly intact, light keyword alignment
# Medium (4-6): rewrites bullets to match JD terminology, adds relevant skills
# High (7-10): aggressively rewrites everything to mirror JD language, maximizes ATS match
TAILORING_INTENSITY=5
APIFY_MAX_POLL_MINUTES=10
# Max jobs to tailor resumes for (top N by score). Rest still appear in tracker.
MAX_TAILOR_COUNT=20

# Telegram alerts (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
# TELEGRAM_ALERT_THRESHOLD=8

# Free scrapers toggle (set to "false" to disable)
# SCRAPE_REMOTEOK=true
# SCRAPE_JOBICY=true
# SCRAPE_HN=true
# SCRAPE_WWR=true
# SCRAPE_ARBEITNOW=true
# SCRAPE_REMOTIVE=true
# SCRAPE_DEVTO=true
# SCRAPE_JOBSIE=true
# SCRAPE_IRISHJOBS=true
# SCRAPE_INDEED_IE=true
# SCRAPE_GRADIRELAND=true
# SCRAPE_CAREERJET=true
# SCRAPE_GLASSDOOR=true

# Keywords for free scrapers (comma-separated)
SEARCH_KEYWORDS=data engineer,data analyst,python developer,sql developer

# Target role (used for relevance scoring — set to your desired role)
TARGET_ROLE=Data Engineer

# Location regions — comma-separated. Controls the pipeline location filter.
# Options: ireland, uk, eu, us, canada, india, apac, all, custom:city1,city2
# Examples:
#   LOCATION_REGIONS=ireland,uk,eu          (default — jobs in Ireland, UK, EU)
#   LOCATION_REGIONS=us,canada              (North American jobs only)
#   LOCATION_REGIONS=all                    (no location filter — keep everything)
#   LOCATION_REGIONS=custom:london,berlin,remote  (only these specific locations)
LOCATION_REGIONS=ireland,uk,eu

# Target countries — which countries to scrape jobs from
# Available: ireland, india (more coming). Comma-separated for multi-country.
# Each country activates its own scrapers and auto-sets LinkedIn geoId.
TARGET_COUNTRIES=ireland

# India-specific scrapers (only run when india is in TARGET_COUNTRIES)
# SCRAPE_NAUKRI=true
# SCRAPE_INSTAHYRE=true
# SCRAPE_INDEED_IN=true

# Max age for scraped jobs (days)
MAX_AGE_DAYS=14

# ─── Auto-generation toggles ───────────────────────────────────────
# Both default to FALSE — cover letter + why-fit are on-demand only.
# The job detail modal exposes a "Generate" button per job; nothing
# is generated automatically during a pipeline run. Set to true here
# only if you want the pipeline to pre-fill every tailored job with
# both assets (uses extra OpenAI tokens).
ENABLE_COVER_LETTER=false
ENABLE_WHY_FIT=false

# ─── Server-internal auth (set by server, do NOT hand-edit) ────────
# The server spawns the pipeline subprocess and injects these two values
# into its environment so the pipeline can authenticate its localhost
# calls back to the server without a Supabase session. They're only
# meaningful for machine-to-machine auth between the two processes.
# PIPELINE_INTERNAL_TOKEN=<generated at server boot>
# PIPELINE_USER_ID=<user id the run belongs to>
