# Extension build-time env. Vite inlines these into the bundle via
# `define` in vite.config.ts - they become string literals at compile
# time, NOT runtime values. Re-run `npm run build --workspace=extension`
# after every change.
#
# Copy this file to .env.local for development. The .local variant is
# gitignored (see .gitignore) so per-developer values stay off the repo.

# Where the GO CANDID8 API server is reachable.
# Local dev:    http://localhost:3001
# Production:   https://<your-railway-or-render-host>
VITE_API_URL=http://localhost:3001

# Where the dashboard SPA is reachable. The popup's "Sign in" button
# opens <DASHBOARD_URL>/?ext_auth=1&ext_id=<id> and the bridge UI on
# that page hands the Supabase session back to the extension.
# Local dev:    http://localhost:5173
# Production:   https://<your-vercel-app>.vercel.app
VITE_DASHBOARD_URL=http://localhost:5173

# Supabase project credentials. Same values the dashboard uses.
# Get them from: Supabase dashboard → Project Settings → API.
# These are the PUBLIC anon key + URL - safe to ship in the extension
# bundle (they're already exposed in the dashboard JS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...your-anon-jwt-here
